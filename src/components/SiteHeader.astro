---
import { siteContent } from '../content/siteContent';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="header" aria-label="Site navigation">
  <div class="brand-wrap">
    <p class="brand">{siteContent.site.name}</p>
    <p class="brand-role">{siteContent.site.role}</p>
  </div>
  <nav class="nav" aria-label="Primary">
    <a href="/" class:list={[currentPath === '/' && 'is-active']}>Home</a>
    <a href="/work/" class:list={[currentPath.startsWith('/work') && 'is-active']}>Work</a>
    <a href="/writing/" class:list={[currentPath.startsWith('/writing') && 'is-active']}>Writing</a>
    <a href="/about/" class:list={[currentPath.startsWith('/about') && 'is-active']}>About</a>
    {
      siteContent.socials.map((social) => (
        <a
          class="nav-social nav-social-icon"
          href={social.href}
          target="_blank"
          rel="noreferrer"
          aria-label={social.label}
          title={social.label}
        >
          {
            social.label === 'GitHub' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.21.68-.47v-1.64c-2.78.61-3.37-1.34-3.37-1.34-.46-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .08 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.84.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.28.1-2.67 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.39.2 2.42.1 2.67.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.91.68 1.84v2.73c0 .26.18.57.69.47A10 10 0 0 0 12 2z" fill="currentColor"></path>
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6.94 8.5H3.56V20h3.38V8.5zm.22-3.56c0-1.02-.77-1.84-1.91-1.84-1.14 0-1.91.82-1.91 1.84 0 1 .75 1.84 1.87 1.84h.02c1.16 0 1.93-.84 1.93-1.84zM20.44 13.4c0-3.4-1.81-4.98-4.23-4.98-1.95 0-2.82 1.07-3.31 1.82V8.5H9.52c.04 1.15 0 11.5 0 11.5h3.38v-6.42c0-.34.03-.68.12-.92.27-.68.88-1.39 1.91-1.39 1.35 0 1.89 1.03 1.89 2.54V20h3.38v-6.6z" fill="currentColor"></path>
              </svg>
            )
          }
        </a>
      ))
    }
    <a class="nav-cta" href="/contact/" class:list={[currentPath.startsWith('/contact') && 'is-active']}>Contact</a>
  </nav>
</header>
