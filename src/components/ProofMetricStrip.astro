---
interface Metric {
  value: string;
  label: string;
  accent?: boolean;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<>
  {
    metrics.map((metric) => (
      <div class:list={['metric', metric.accent && 'metric-accent']}>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))
  }
</>
